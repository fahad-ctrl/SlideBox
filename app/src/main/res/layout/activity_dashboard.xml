<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F4F6FC">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SLIDEBOX"
        android:textColor="#53658C"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Teacher Dashboard"
        android:textColor="#172033"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Welcome"
        android:textColor="#536079"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:text="Select PDF"
        android:textColor="#FFFFFF"
        android:backgroundTint="#243B80"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/tvListTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="16dp"
        android:text="Saved slides"
        android:textColor="#172033"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="Your slide collection starts here.\nSelect a PDF to add your first slide."
        android:textColor="#536079"
        android:textSize="16sp" />

    <ListView
        android:id="@+id/listSlides"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>